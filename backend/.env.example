# Copy to backend/.env for local development. backend/.env is git-ignored.
# Never commit real keys, tokens or service-account files.

APP_ENV=development
# SQLite for zero-setup development. Production: postgresql+psycopg://user:pass@host:5432/milega
# (PostgreSQL with the PostGIS and pg_trgm extensions; `alembic upgrade head` enables them when allowed.)
DATABASE_URL=sqlite:///data/milega.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-before-production
ACCESS_TOKEN_DAYS=30

# ---------------------------------------------------------------- OTP / SMS
# console        -> logs the code and returns it to the app (development only; refused in production)
# msg91          -> DLT-registered SMS template through MSG91 Flow API
# twilio_verify  -> Twilio Verify creates and checks the code
SMS_PROVIDER=console
EXPOSE_DEV_OTP=true
OTP_TTL_SECONDS=300
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=           # DLT template containing ##otp##
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# Comma-separated mobile numbers that become admins on login.
ADMIN_PHONES=+919000000001

# --------------------------------------------------------- Google Maps Platform
# Server-side key for Places API (New): business discovery, locality autocomplete, landmarks.
# Restrict it in Google Cloud Console: API restriction = "Places API (New)", application
# restriction = your server's IP addresses. Set a quota and a billing budget alert.
GOOGLE_PLACES_SERVER_API_KEY=
# Hard daily cap on Places requests made by this server (all replicas share it via the database).
PLACES_DAILY_REQUEST_LIMIT=2000
# The Android Maps SDK key is NOT configured here: put MAPS_API_KEY in android/local.properties.

# ------------------------------------------------------------- data visibility
# Sample "demo" shops are shown outside production only.
SHOW_DEMO_DATA=true
# Merchants awaiting verification stay hidden from customers unless enabled.
SHOW_UNVERIFIED_MERCHANTS=false
# New shops need admin verification before customers see them.
AUTO_APPROVE_SHOPS=false

# ------------------------------------------------------- push notifications
# Firebase Cloud Messaging HTTP v1. Without these, the app uses in-app notifications + polling.
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json

# ---------------------------------------------------------------- operations
# Shared rate limits across API replicas. Empty -> in-process limits (single instance only).
# REDIS_URL=redis://localhost:6379/0
# SENTRY_DSN=
# CORS_ORIGINS=https://admin.milega.example

# ------------------------------------------------------- photo recognition
# auto   -> Claude vision when ANTHROPIC_API_KEY is set, otherwise on-device OCR matching
# ocr    -> free path: text read on the phone (ML Kit) matched to the catalogue
VISION_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
VISION_MODEL=claude-opus-5-5
VISION_EFFORT=medium

STORAGE_BACKEND=local
STORAGE_DIR=data/uploads
# S3_BUCKET=
# S3_ENDPOINT_URL=

PENDING_RESERVATION_MINUTES=30
CONFIRMED_HOLD_MINUTES=180
